{
	"appId": "org.diadikasia.app",
	"appName": "Diadikasia",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#ffffff",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#0f172a",
			"overlaysWebView": false
		}
	},
	"packageClassList": [
		"AppPlugin",
		"HapticsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
